# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# uv
# (uv.lock IS committed — it's the reproducibility anchor)

# Jupyter
.ipynb_checkpoints/

# Data — the corpus and any cached COGs are large and reproducible; never commit
# `data/*` rather than `data/`: git cannot re-include anything under an excluded
# *directory*, and the corpus index below has to be re-included (issue #51). Note the
# side effect — a pattern containing a slash is anchored to this file's directory,
# where bare `data/` matched at any depth, so `notebooks/data/` needs its own line.
data/*
notebooks/data/
# The corpus's shards are ~5 GB and rebuildable from the committed selection list,
# but the manifest and the corpus card *describe* the build — they are what the model
# card, the E2 report and the Gate-E review read, so they ship.
!data/corpus_50k/
data/corpus_50k/*
!data/corpus_50k/manifest.parquet
!data/corpus_50k/corpus_meta.json
# The scale tier (issue #72), on the same rule at ten times the size: ~50 GB of shards
# stay out, the index and the card ship. `build_state.json` is resume bookkeeping and is
# caught by the `data/corpus_500k/*` line — it describes an *attempt*, not a corpus.
!data/corpus_500k/
data/corpus_500k/*
!data/corpus_500k/manifest.parquet
!data/corpus_500k/corpus_meta.json
tiles/
shards/
*.tif
*.tiff
*.zarr/
cache/

# Prototypes — throwaway exploration code + figures (self-deleting per their headers); kept local only
prototypes/

# Env / secrets
.env
.env.*

# OS
.DS_Store
notebooks/out/

# Provision/teardown scratch (scripts/): the box identity a run should be tagged with, and the
# hauled artifacts a destroyed instance left behind.
.box_identity

# The code version shipped to a box with no `.git` (dataset.provenance.SHA_FILE). Generated per
# push and never committed: in a real checkout git answers first, so a committed copy could only
# ever be a stale value riding along to the next box.
.git_sha

# Teardown hauls land beside the repo, one directory per destroyed instance.
teardown-*/
